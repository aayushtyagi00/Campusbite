# Supabase Auth for all portals, plus the commerce database.
# Configure Google and Email in this staff Supabase project.
# The approved admin email and each vendor email, shop, and role live in the database.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Use public HTTPS origins in production. Loopback is for local development.
CAMPUSBITE_STAFF_ORIGIN=http://127.0.0.1:3000
# Optional for a separate student hostname. Defaults to the staff origin.
CAMPUSBITE_STUDENT_ORIGIN=
# Use live for the database catalog and provider-backed checkout. Student accounts always use Supabase.
CAMPUSBITE_MODE=live
# Public ordering accounts accept valid email addresses from any domain.
# Leave both blank to use the shared project. Only set both for a separate student Auth project.
STUDENT_SUPABASE_URL=
STUDENT_SUPABASE_PUBLISHABLE_KEY=

# Self-hosted deployments behind a trusted ingress only. Leave blank on Vercel.
# Use cf-connecting-ip, x-real-ip, or x-forwarded-for. See README for origin restrictions.
CAMPUSBITE_TRUSTED_PROXY_HEADER=
# For x-forwarded-for, comma-separated CIDRs of additional trusted proxies.
CAMPUSBITE_TRUSTED_PROXY_CIDRS=
# Turnstile for public reviews, student signup, and recovery challenges.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Razorpay. Use Test Mode credentials while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate test-only credentials for the administrator's simulated ₹1 payment.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMMERCE_JOB_SECRET=

# Web Push. Configure the public key before building the app.
NEXT_PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
