# Vendor and admin sign-in, plus the commerce database.
# Configure Google and Email in this staff Supabase project.
# The approved admin email and each vendor email, shop, and role live in the database.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# App origin shared by the public ordering, vendor, and admin callback URLs.
CAMPUSBITE_STAFF_ORIGIN=http://127.0.0.1:3000
# Use live to enable real public ordering accounts and provider-backed checkout.
CAMPUSBITE_MODE=preview
# Public ordering accounts accept valid email addresses from any domain.
# These STUDENT_SUPABASE settings point to the separate public Supabase Auth project.
# Configure Google and Email in that project. Set the Google OAuth credentials in Supabase.
STUDENT_SUPABASE_URL=
STUDENT_SUPABASE_PUBLISHABLE_KEY=
# Razorpay. Use Test Mode credentials while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMMERCE_JOB_SECRET=
